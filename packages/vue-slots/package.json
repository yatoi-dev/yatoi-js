  "description": "Typed contribution points for @yatoi/kernel, for Vue: contribute() and <Slot>.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yatoi-dev/yatoi-js.git",
    "directory": "packages/vue-slots"
  },
  "homepage": "https://github.com/yatoi-dev/yatoi-js/tree/main/packages/vue-slots#readme",
