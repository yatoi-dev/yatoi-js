{
  "name": "@yatoyi/slots",
  "version": "0.0.0",
  "description": "Typed contribution points for @yatoyi/kernel: contribute() and <Slot>.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -b tsconfig.json && tsc -b tsconfig.test.json",
    "test": "vitest run --project slots --root ../.."
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@yatoyi/kernel": "workspace:*",
    "@yatoyi/react": "workspace:*"
  },
  "keywords": [
    "react",
    "plugin-architecture",
    "plugin-system",
    "extension-points",
    "slots"
  ]
}
