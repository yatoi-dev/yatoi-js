{
  "name": "@yatoi/slots",
  "version": "0.2.0",
  "description": "Framework-neutral slot contract for @yatoi/kernel: the Slots interface and slot().",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yatoi-dev/yatoi-js.git",
    "directory": "packages/slots"
  },
  "homepage": "https://github.com/yatoi-dev/yatoi-js/tree/main/packages/slots#readme",
  "bugs": "https://github.com/yatoi-dev/yatoi-js/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "AGENTS.md",
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc -b tsconfig.json && tsc -b tsconfig.test.json",
    "test": "vitest run --project slots --root ../.."
  },
  "dependencies": {
    "@yatoi/kernel": "workspace:^"
  },
  "keywords": [
    "plugin-architecture",
    "plugin-system",
    "extension-points",
    "slots"
  ]
}
