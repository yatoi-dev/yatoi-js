{
  "name": "@yatoyi/react",
  "version": "0.0.0",
  "description": "React bridge for @yatoyi/kernel: KernelProvider, useService, Requires, usePlugin.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -b tsconfig.json && tsc -b tsconfig.test.json",
    "test": "vitest run --project react --root ../.."
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@yatoyi/kernel": "workspace:*"
  },
  "keywords": [
    "react",
    "plugin-architecture",
    "plugin-system",
    "dependency-injection",
    "lifecycle"
  ]
}
