{
  "name": "@yatoi/react",
  "version": "0.1.0",
  "description": "React bridge for @yatoi/kernel: KernelProvider, useService, Requires, usePlugin.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yatoi-dev/yatoi-js.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/yatoi-dev/yatoi-js/tree/main/packages/react#readme",
  "bugs": "https://github.com/yatoi-dev/yatoi-js/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc -b tsconfig.json && tsc -b tsconfig.test.json",
    "test": "vitest run --project react --root ../.."
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@yatoi/kernel": "workspace:^"
  },
  "keywords": [
    "react",
    "plugin-architecture",
    "plugin-system",
    "dependency-injection",
    "lifecycle"
  ]
}
