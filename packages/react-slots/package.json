{
  "name": "@yatoi/react-slots",
  "version": "0.0.0",
  "description": "React binding for @yatoi/slots: contribute() and <Slot>.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yatoi-dev/yatoi-js.git",
    "directory": "packages/react-slots"
  },
  "homepage": "https://github.com/yatoi-dev/yatoi-js/tree/main/packages/react-slots#readme",
  "bugs": "https://github.com/yatoi-dev/yatoi-js/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -b tsconfig.json && tsc -b tsconfig.test.json",
    "test": "vitest run --project react-slots --root ../.."
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@yatoi/kernel": "workspace:*",
    "@yatoi/react": "workspace:*",
    "@yatoi/slots": "workspace:*"
  },
  "keywords": [
    "react",
    "plugin-architecture",
    "plugin-system",
    "extension-points",
    "slots"
  ]
}
