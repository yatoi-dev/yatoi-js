{
  "name": "@yatoi/kernel",
  "version": "0.2.0",
  "description": "Plugin kernel: scoped reversible effects, typed service discovery, and cascade unload. No React, no DOM.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yatoi-dev/yatoi-js.git",
    "directory": "packages/kernel"
  },
  "homepage": "https://github.com/yatoi-dev/yatoi-js/tree/main/packages/kernel#readme",
  "bugs": "https://github.com/yatoi-dev/yatoi-js/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "AGENTS.md",
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run --project kernel --root ../.."
  },
  "keywords": [
    "plugin-architecture",
    "plugin-system",
    "dependency-injection",
    "micro-kernel",
    "lifecycle"
  ]
}
