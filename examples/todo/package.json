{
  "name": "yatoyi-example-todo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:remote": "VITE_PLUGIN_BASE=http://localhost:5174 vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "build:plugin": "vite build --config vite.plugin.config.ts",
    "serve:plugin": "vite build --config vite.plugin.config.ts && vite preview --config vite.plugin.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@yatoyi/kernel": "workspace:*",
    "@yatoyi/react": "workspace:*",
    "@yatoyi/slots": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.6"
  }
}
